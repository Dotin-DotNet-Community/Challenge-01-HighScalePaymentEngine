{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "TransactionEngine": {
    "HealthWatchdog": {
      "DefaultCheckInterval": "00:00:01",
      "DisposeBehavior": "CancelOnly",
      "ShutdownTimeout": "00:00:02"
    },
    "Batching": {
      "FailurePolicy": "ContinueOnError"
    },
    "RiskEvaluation": {
      "FailurePolicy": "Ignore"
    }
  }
}